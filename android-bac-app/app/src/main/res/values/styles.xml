<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_teal</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme_Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#35C9AF</item>
        <item name="android:statusBarColor">#111820</item>
        <item name="android:navigationBarColor">#1B2631</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#111820</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
