<Window x:Class="BacNoteCalcule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAC Note calculé"
        Width="1220" Height="720"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SoftGreenBrush}"
                        VerticalAlignment="Center">
                    <Image Source="/resources/bac_logo.png" Width="34" Height="34"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="HeaderTitle" Text="BAC Note calculé"
                               FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Calculatrice du baccalauréat marocain"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="RedditButton" Grid.Column="2"
                        Style="{StaticResource RedditButtonStyle}" Margin="0,0,9,0"
                        Click="RedditButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/resources/reddit_icon.png" Width="21" Height="21"
                               Stretch="Uniform" />
                        <TextBlock x:Name="RedditLabel" Text="Reddit" Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="DonationButton" Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"
                        Click="DonationButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="21" Height="21" CornerRadius="11"
                                Background="#0759A5" Margin="0,0,7,0">
                            <Grid>
                                <TextBlock Text="P" Foreground="#79C9F2" FontSize="14"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="-2,0,0,1" />
                                <TextBlock Text="P" Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="2,1,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DonationLabel" Text="Donation"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="LanguageButton" Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="88"
                        Margin="0,0,9,0" Click="LanguageButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="24" Height="16" Margin="0,0,7,0">
                            <Grid x:Name="FrenchFlag" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Background="#002395" />
                                <Border Grid.Column="1" Background="White" />
                                <Border Grid.Column="2" Background="#ED2939" />
                            </Grid>
                            <Grid x:Name="MoroccoFlag" Visibility="Collapsed">
                                <Border Background="#C1272D" />
                                <TextBlock Text="★" Foreground="#006233" FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="LanguageCodeLabel" Text="FR"
                                   FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="▾" Foreground="{DynamicResource MutedBrush}"
                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Grid.Column="5"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="84"
                        Click="ThemeButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeIcon" Text="☾" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ThemeLabel" Text="Dark"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,8">
                <Border Style="{StaticResource CardStyle}" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TrackCaption" Text="VOTRE FILIÈRE"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="TrackDescription" Text="Choisissez votre filière pour afficher les matières correspondantes."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,3,14,0" />
                        </StackPanel>
                        <ComboBox x:Name="TrackCombo" Grid.Column="1" Height="42"
                                  Style="{StaticResource TrackComboBoxStyle}"
                                  FontSize="13" Padding="10,7"
                                  Background="{DynamicResource InputBrush}"
                                  Foreground="{DynamicResource TextBrush}"
                                  BorderBrush="{DynamicResource LineBrush}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="TrackCombo_SelectionChanged" />
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="NationalTitle" Text="Examen national"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="NationalHint" Text="Saisissez vos notes sur 20."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,3,0,12" />
                                <ItemsControl x:Name="NationalSubjects">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="122" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GradeTextBoxStyle}"
                                                         ToolTip="0 – 20" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="NationalCalculateButton"
                                        Content="Calculer la moyenne nationale"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                        Click="NationalCalculateButton_Click" />
                                <TextBlock x:Name="NationalResultText"
                                           Text="Moyenne nationale : -- / 20"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="ContinuousTitle" Text="Contrôle continu"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="ContinuousHint" Text="Moyenne des deux semestres."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,3,0,12" />
                                <ItemsControl x:Name="ContinuousSubjects">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="122" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GradeTextBoxStyle}"
                                                         ToolTip="0 – 20" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ContinuousCalculateButton"
                                            Content="Calculer la moyenne"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="ContinuousCalculateButton_Click" />
                                    <TextBlock x:Name="ContinuousResultText"
                                               Grid.Column="1" Text="-- / 20"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="RegionalTitle" Text="Examen régional"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="RegionalHint" Text="Saisissez vos notes sur 20."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,3,0,12" />
                                <ItemsControl x:Name="RegionalSubjects">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="122" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GradeTextBoxStyle}"
                                                         ToolTip="0 – 20" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="RegionalCalculateButton"
                                        Content="Calculer la moyenne régionale"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                        Click="RegionalCalculateButton_Click" />
                                <TextBlock x:Name="RegionalResultText"
                                           Text="Moyenne régionale : -- / 20"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SoftGreenBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="WeightsTitle" Text="Calcul de la moyenne générale"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeightsDescription"
                                           Text="Contrôle continu 25 %  ·  Régional 25 %  ·  National 50 %"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterTitle" Text="Prêt à calculer votre moyenne ?"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="FooterHint" Text="Complétez les notes nationales, régionales et de contrôle continu."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="GeneralCalculateButton" Grid.Column="1"
                        Content="Calculer la moyenne générale"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="260" Height="48" FontSize="15"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="GeneralCalculateButton_Click" />
            </Grid>
        </Border>

        <Grid x:Name="ResultOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{DynamicResource OverlayBrush}" Panel.ZIndex="10"
              MouseDown="ResultOverlay_MouseDown">
            <Border x:Name="ResultCard" Width="500" Padding="30,26"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ResultScale" ScaleX="0.94" ScaleY="0.94" />
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="PopupTitle" Text="Votre moyenne générale"
                               FontSize="17" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" />
                    <Grid Width="190" Height="190" Margin="0,16,0,12">
                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="12" />
                        <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="12" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PopupScore" Text="18.00"
                                       FontSize="40" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/ 20" FontSize="17"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,-2,0,8" />
                            <Border x:Name="MentionBadge" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="16" Padding="17,6">
                                <TextBlock x:Name="PopupMention" Text="Excellent"
                                           FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FeedbackPanel" Background="{DynamicResource SoftBlueBrush}"
                            CornerRadius="16" Padding="18,16" Margin="0,4,0,18">
                        <StackPanel>
                            <TextBlock x:Name="PopupFeedbackTitle" Text="Bravo !"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="PopupFeedback" Text="Félicitations pour votre résultat !"
                                       FontSize="14" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CloseResultButton" Content="Continuer"
                            Style="{StaticResource PrimaryButtonStyle}" Height="46"
                            Click="CloseResultButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
